# ========================================================
# 指定地圖掉落與全地圖掉落 (Map & Global Drop) 設定範例
# 伺服器優先讀取 DB _config 與 w_map_designated_drop 資料表
# ========================================================

# 指定地圖掉落系統總開關 (0=關閉, 1=開啟)
MapDesignatedDropSwitch = 1

# 全地圖通用掉落池開關 (0=關閉, 1=開啟)
GlobalMapDropSwitch = 1
