# ========================================================
# 暗黑打寶系統 (炫色掉落優化) 設定說明
# ========================================================

# 1. 系統總開關
DarkLoot_Enable = true

# 2. 暗黑裝備全伺服器掉落率 (1~10000，例如 50 代表 0.5%)
dropcolor_chance = 50

# 3. 未鑑定保密防呆 (true=未鑑定隱藏前綴與孔洞，必須鑑定才揭露)
DarkLoot_HideUnidentified = true