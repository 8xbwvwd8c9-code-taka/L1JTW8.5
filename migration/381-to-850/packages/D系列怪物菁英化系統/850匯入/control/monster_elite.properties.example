# D系列怪物菁英化系統 — 控制設定說明
# 備註：依企劃最新指示，總開關與開放時段改由 DB [_config] 資料表權威控制。
# 此處為對照說明檔。

# ========================================================
# DB [_config] 設定條目說明：
# ========================================================
# 1. 系統總開關
# parameter: EliteMonsterSwitch
# value: 0=關閉, 1=開啟 (預設: 0)
#
# 2. 開放時段 (現實世界24小時制)
# parameter: EliteMonsterTimeSchedule
# value: 
#   0     -> 全天候 24 小時開放
#   23    -> 每天 23:00~23:59 開放 (預設)
#   1-2   -> 每天 01:00~02:59 開放
#   18-20 -> 每天 18:00~20:59 開放
# ========================================================

# 細部機率與倍率 (由 w_elite_monster_config 表與 Config 控制)
EliteMonsterSpawnChance=10
EliteMonsterHpMultiplierPct=130
EliteDropRateMultiplierPct=200
SummonAiDamageReductionPct=30
MonsterSpellTierEnabled=true
MonsterUsePlayerBuffSkills=true
MonsterUsePlayerAttackSkills=true
