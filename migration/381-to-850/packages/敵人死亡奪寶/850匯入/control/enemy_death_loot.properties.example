# ========================================================
# 敵人死亡奪寶與紅人假人邊緣追殺設定
# ========================================================

# 1. 系統總開關
EnemyDeathLoot_Enable = true

# 2. 紅人假人追殺模式
# 是否啟用玩家視野外邊緣(16~20格)刷新紅人假人主動追殺
RedBot_EdgeSpawnHuntEnabled = true
# 觸發追殺的最低玩家等級
RedBot_TargetMinLevel = 65
# 紅人假人刷新間隔 (秒，例如 600 代表每 10 分鐘判定一次)
RedBot_HuntIntervalSec = 600
# 追殺假人是否強制設定為紅名/狂暴狀態 (正義值 -32768)
RedBot_ForceChaotic = true

# 3. 奪寶與掉落設定
# 遭紅人假人擊殺時是否強制扣除被殺者背包金幣/道具
StealOnDeathEnabled = true