# ========================================================
# 天M娃娃與卡片合成系統 (850 原生化) 設定說明
# ========================================================

# 1. 系統總開關
TmCombine_Enable = true

# 2. 全域合成機率倍率 (100 = 原機率, 200 = 雙倍機率)
TmCombine_ChanceRate = 100

# 3. 保底機制開關 (是否在失敗達指定次數後強制觸發必中合成)
TmCombine_PityEnabled = true